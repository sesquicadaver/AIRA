{
  "$id": "aira:schema:protocol:crp-route-candidate:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_candidate_id",
    "route_request_id",
    "capability_chain",
    "estimated_cost",
    "evidence_refs",
    "confidence",
    "signature"
  ],
  "properties": {
    "route_candidate_id": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "route_request_id": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "capability_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_ref",
          "provider_csu",
          "role",
          "policy_refs"
        ],
        "properties": {
          "capability_ref": {
            "$ref": "aira:schema:common:ref:0.1"
          },
          "provider_csu": {
            "$ref": "aira:schema:common:ref:0.1"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "$ref": "aira:schema:common:ref:0.1"
            }
          }
        }
      }
    },
    "estimated_cost": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "amount": {
          "type": ["number", "null"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "currency": {
          "type": ["string", "null"]
        }
      }
    },
    "risk_descriptor_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "aira:schema:common:ref:0.1" }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "aira:schema:common:ref:0.1"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signature": {
      "$ref": "aira:schema:common:signature:0.1"
    }
  }
}
