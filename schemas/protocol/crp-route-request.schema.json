{
  "$id": "aira:schema:protocol:crp-route-request:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_request_id",
    "capsule_ref",
    "required_capabilities",
    "context_ref",
    "policy_refs",
    "constraints",
    "issuer_identity",
    "signature"
  ],
  "properties": {
    "route_request_id": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "capsule_ref": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "aira:schema:capability:descriptor:0.1"
      }
    },
    "context_ref": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "$ref": "aira:schema:common:ref:0.1"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cost_max": {
          "type": ["number", "null"]
        },
        "latency_max": {
          "type": ["string", "null"]
        },
        "reliability_min": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "privacy_class": {
          "type": ["string", "null"]
        },
        "federation_scope": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "aira:schema:common:scope-descriptor:0.1" }
          ]
        }
      }
    },
    "issuer_identity": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "signature": {
      "$ref": "aira:schema:common:signature:0.1"
    }
  }
}
