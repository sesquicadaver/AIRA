      }
    },
    "object_refs": {
      "type": "array",
      "items": {
        "$ref": "aira:schema:common:ref:0.1"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "aira:schema:common:ref:0.1"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "$ref": "aira:schema:common:ref:0.1"
      }
    },
    "payload_hash": {
      "$ref": "aira:schema:common:hash:0.1"
