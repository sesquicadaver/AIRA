      "enum": [
        "ProblemSubmitted",
        "ContextResolved",
        "ReductionCompleted",
        "CapsuleCreated",
        "CapsuleBound",
        "CapsuleCompleted",
        "CapsuleFailed",
        "VerificationCompleted",
        "VerificationFailed",
        "ResultPublished",
        "ArtifactPublished",
        "ArtifactResolved",
        "ArtifactInvalid",
        "ArtifactSuperseded",
        "CapabilityRegistered",
        "PolicyEvaluated",
        "CSURegistered",
        "CSUSuspended",
        "CSUFailed",
        "InvariantViolation",
        "FailureEvidenceCreated",
        "ResearchArtifactCreated",
        "ArtifactPromotionCandidate",
        "CustomEvent"
