{
  "$id": "aira:schema:desktop:peer-invite:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_schema",
    "identity_ref",
    "public_key_hex"
  ],
  "properties": {
    "payload_schema": {
      "type": "string",
      "const": "aira:schema:desktop:peer-invite:0.1"
    },
    "identity_ref": {
      "$ref": "aira:schema:common:ref:0.1",
      "description": "Peer's verifying identity ref (typically aira:identity:…)."
    },
    "public_key_hex": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "Ed25519 verifying public key as 32-byte hex (64 chars)."
    },
    "addr": {
      "type": ["string", "null"],
      "description": "Optional dialable host:port for address book upsert. Null/omitted = trust-only invite."
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Optional human label; not used for trust or dial."
    },
    "created_at": {
      "$ref": "aira:schema:common:timestamp:0.1"
    }
  }
}
