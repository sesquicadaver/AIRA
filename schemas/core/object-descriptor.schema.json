        "Context",
        "Evidence",
        "EpistemicStatus",
        "ExecutionIntent",
        "ExecutionCapsule",
        "Capability",
        "Artifact",
        "Event",
        "Policy",
        "CSU",
        "VerifiedResultArtifact"
      ]
