{
  "$id": "aira:schema:model:share-offer:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_schema",
    "offer_id",
    "publisher_ref",
    "model_artifact_ref",
    "content_hash",
    "visibility",
    "allow_download",
    "created_at",
    "signature"
  ],
  "properties": {
    "payload_schema": {
      "type": "string",
      "const": "aira:schema:model:share-offer:0.1"
    },
    "offer_id": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "publisher_ref": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "model_artifact_ref": {
      "$ref": "aira:schema:common:ref:0.1",
      "description": "Ref to signed ModelArtifact descriptor payload (not raw weights)."
    },
    "content_hash": {
      "$ref": "aira:schema:common:hash:0.1",
      "description": "Hash of the model weight payload referenced by the offer."
    },
    "visibility": {
      "type": "string",
      "enum": ["local", "opt_in"],
      "description": "local = host-only; opt_in = explicit share without forcing global availability. Global/network advertise is Out of 0.1."
    },
    "allow_download": {
      "type": "boolean",
      "default": false,
      "description": "Whether peers may request download of this offer; default false."
    },
    "model_profile_ref": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "license_policy_ref": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "capability_hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "$ref": "aira:schema:common:timestamp:0.1"
    },
    "signature": {
      "$ref": "aira:schema:common:signature:0.1"
    }
  }
}
