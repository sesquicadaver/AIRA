      "minLength": 1
    },
    "parameter_class": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "$ref": "aira:schema:common:hash:0.1"
    },
    "tokenizer_ref": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "license_policy_ref": {
      "$ref": "aira:schema:common:ref:0.1"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "$ref": "aira:schema:common:ref:0.1"
      }
    },
    "signature": {
      "$ref": "aira:schema:common:signature:0.1"
    }
